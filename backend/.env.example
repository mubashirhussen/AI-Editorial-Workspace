# Application & Environment
APP_NAME=AI Editorial Workspace
ENVIRONMENT=development
DATABASE_URL=sqlite:///./editorial.db

# Authentication & Security
SECRET_KEY=super-secret-editorial-ai-jwt-key-change-in-production
ENCRYPTION_KEY=
ALLOW_ANONYMOUS_DEV=true

# AI Providers (Optional - falls back to deterministic editorial engines when omitted)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEFAULT_AI_PROVIDER=groq
DEFAULT_AI_MODEL=openai/gpt-oss-20b

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:5173
