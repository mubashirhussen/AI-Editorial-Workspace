# ==============================================================================
# AI Editorial Workspace - Environment Configuration Template
# Copy this file to .env (or backend/.env and frontend/.env) for local dev.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
APP_NAME=AI Editorial Workspace
API_V1_PREFIX=/api/v1

# Database URL:
# For Local Development (SQLite):
DATABASE_URL=sqlite:///./editorial.db
# For Production (PostgreSQL e.g. Render / Supabase / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI Provider Settings (OpenAI-compatible):
# Leave AI_API_KEY blank to run in 100% offline deterministic fallback mode
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# CORS & Frontend Origins:
FRONTEND_ORIGIN=http://localhost:5173

# Extraction Limits:
MAX_EXTRACTION_BYTES=2097152
MAX_CONTENT_CHARS=100000
EXTRACTION_TIMEOUT_SECONDS=12
MAX_REDIRECTS=4

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
# For Local Development:
VITE_API_BASE_URL=http://localhost:8000/api/v1
# For Production:
# VITE_API_BASE_URL=https://ai-editorial-workspace-backend.onrender.com/api/v1

