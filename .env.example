# AI Editorial Workspace environment template.
# Copy to .env. Never commit the populated .env file.
# For Docker Compose, set both JWT_SECRET and POSTGRES_PASSWORD before startup.

APP_NAME=AI Editorial Workspace
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DATABASE_URL=sqlite:///./editorial.db

# Use a random secret of at least 32 characters in production.
# Example generation (PowerShell): [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=

# Required by docker-compose.yml. Use a strong, unique password.
POSTGRES_USER=editorial_user
POSTGRES_PASSWORD=
POSTGRES_DB=editorial_workspace

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
ENCRYPTION_KEY=

DEFAULT_AI_PROVIDER=groq
DEFAULT_AI_MODEL=openai/gpt-oss-20b

FRONTEND_ORIGIN=http://localhost:5173
MAX_EXTRACTION_BYTES=2097152
MAX_CONTENT_CHARS=100000
EXTRACTION_TIMEOUT_SECONDS=12
MAX_REDIRECTS=4
VITE_API_BASE_URL=http://localhost:8000/api/v1
