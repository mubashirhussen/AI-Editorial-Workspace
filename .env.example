# ==============================================================================
# AI Editorial Workspace - Production & Development Environment Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local deployment (or supply via CI/CD secrets / Kubernetes Secret).
# 2. In production, run 'python scripts/generate_secrets.py' to generate secure random keys.
# 3. NEVER commit the resulting '.env' file or any real secrets to source control.
# ==============================================================================

# --- Deployment Environment ---
# Options: development, staging, production
ENVIRONMENT=development
TESTING=false
APP_NAME="AI Editorial Workspace"
API_V1_PREFIX=/api/v1

# --- Security & Cryptography ---
# CRITICAL: In production, SECRET_KEY must be >= 32 characters and cannot use default/weak strings.
# Generate via: python scripts/generate_secrets.py
SECRET_KEY=dev_insecure_key_for_local_testing_only_replace_before_deploying_to_production_32_chars
# Fernet-compatible 32-byte urlsafe base64 key for database-at-rest credential encryption
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# In production, ALLOW_ANONYMOUS_DEV must be set to false.
ALLOW_ANONYMOUS_DEV=true

# --- Database Configuration ---
# Local SQLite default:
DATABASE_URL=sqlite:///./editorial.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://editorial_user:change_this_strong_password@db:5432/editorial_workspace
POSTGRES_USER=editorial_user
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=editorial_workspace

# --- Redis & Task Queue ---
# Required for distributed task processing and Celery/async queue in production:
# REDIS_URL=redis://redis:6379/0
REDIS_URL=

# --- Observability & Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- CORS & Networking ---
# Comma-separated list of trusted client origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
FRONTEND_ORIGIN=http://localhost:5173

# --- AI Provider API Credentials ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# Default Active Model & Provider
DEFAULT_AI_PROVIDER=groq
DEFAULT_AI_MODEL=openai/gpt-oss-20b

# --- Secure Extraction Invariants ---
MAX_EXTRACTION_BYTES=2097152
MAX_CONTENT_CHARS=100000
EXTRACTION_TIMEOUT_SECONDS=12
MAX_REDIRECTS=4

# --- Frontend Build Variables ---
VITE_API_BASE_URL=/api/v1
