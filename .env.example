# ==============================================================================
# AI Editorial Workspace - Environment Configuration Template
# Copy this file to .env (which is strictly gitignored) for local development.
# Never commit real credentials to version control.
# ==============================================================================

# Core Application
APP_NAME=AI Editorial Workspace
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./editorial.db
JWT_SECRET=super-secret-editorial-ai-jwt-key-change-in-production

# AI Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
ENCRYPTION_KEY=

# Default Active Model & Provider
DEFAULT_AI_PROVIDER=groq
DEFAULT_AI_MODEL=openai/gpt-oss-20b

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:5173

# Extraction Limits
MAX_EXTRACTION_BYTES=2097152
MAX_CONTENT_CHARS=100000
EXTRACTION_TIMEOUT_SECONDS=12
MAX_REDIRECTS=4

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
